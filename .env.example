# Optional: AI Provider API Keys (Gemini, OpenAI, Anthropic, or Groq)
# If left blank, the app will seamlessly run in High-Fidelity Simulation / Fallback Mode!
# This ensures zero-friction evaluation for reviewers.

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
OPENAI_API_KEY=

# Optional custom model override
AI_MODEL_NAME=gemini-2.5-flash
